---
/** The mark beside the wordmark: lib/logo.ts says what it is made of. */
import { logoStops } from '@lib/logo';

interface Props { size?: string; }
const { size = '1em' } = Astro.props;
const stops = logoStops();
---
<svg class="logo" viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="logo-gradient" x1="0" x2="1" y1="0" y2="0">
      {stops.map((s) => <stop offset={s.at.toFixed(4)} stop-color={s.colour} />)}
    </linearGradient>
  </defs>
  <circle cx="32" cy="32" r="32" fill="url(#logo-gradient)" />
</svg>

<style>
  .logo { display: block; flex: none; }
</style>
